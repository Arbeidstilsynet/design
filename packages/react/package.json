    "eslint-plugin-storybook": "10.5.10",
    "happy-dom": "20.11.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-toastify": "11.1.0",
    "storybook": "10.5.10",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.0.3"
