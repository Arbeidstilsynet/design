{
  "name": "root",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens:create": "pnpm designsystemet tokens create --clean",
    "tokens:build": "pnpm designsystemet tokens build --clean -o ./packages/theme/brand",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -b",
    "typecheck:scripts": "tsc --project scripts",
    "lint": "oxlint .",
    "dev": "pnpm storybook",
    "test": "vitest run --project '!@arbeidstilsynet/storybook (storybook-*)'",
    "build": "pnpm -r build",
    "build:react": "pnpm --filter @arbeidstilsynet/design-react build",
    "build:storybook": "pnpm --filter storybook... build",
    "version": "changeset version && tsx scripts/postprocess-changelogs.ts",
    "release": "pnpm build && changeset publish",
    "storybook": "pnpm --filter storybook dev",
    "storybook:serve": "pnpm --filter storybook serve"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@changesets/get-github-info": "1.0.1",
    "@changesets/types": "7.0.0",
    "@digdir/designsystemet": "1.22.0",
    "@scaleway/changesets-renovate": "4.0.4",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "workspace:*",
    "eslint-plugin-storybook": "10.6.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.8.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.8.2+sha512.a5941679663d952c5f0ecc38ba98af98b4dc01b95780354f6894f2f873973cef2f7e2989d7db3ee5393938ae21f62fe06bcdf685d475ddad829a62095d2b8b11"
}
